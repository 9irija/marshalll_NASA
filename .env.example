# Flight Controller (optional: without a key it runs in labelled offline mode)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Serve precomputed responses from data/processed/demo when 1
DEMO_MODE=0
# Comma-separated web origins allowed by CORS (plus *.vercel.app by default)
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web app: API base URL (build time)
VITE_API_URL=http://localhost:8000
